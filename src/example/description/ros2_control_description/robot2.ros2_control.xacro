<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="Robot4Farmers" params="use_sim:=false">
    <ros2_control name="robot2_hardware" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <!-- Gazebo simulation hardware interface -->
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <!-- Real robot hardware interface -->
          <plugin>example/Robot4FarmersHardware</plugin>
        </xacro:unless>
      </hardware>

      <joint name="front_wheels_joint">
        <state_interface name="temperature_front_left"/>
        <state_interface name="temperature_front_right"/>
        <state_interface name="temperature_front_timestamp"/>
        <state_interface name="velocity_front_left"/>
        <state_interface name="velocity_front_right"/>
        <state_interface name="velocity_front_timestamp"/>
        <state_interface name="throttle_front_left"/>
        <state_interface name="throttle_front_right"/>
        <state_interface name="throttle_front_timestamp"/>
        <state_interface name="reverse_front_left"/>
        <state_interface name="reverse_front_right"/>
        <state_interface name="reverse_front_timestamp"/>
        <state_interface name="brake_front_left"/>
        <state_interface name="brake_front_right"/>
        <state_interface name="brake_front_timestamp"/>
      </joint>
      <joint name="rear_wheels_joint">
        <state_interface name="temperature_rear_left"/>
        <state_interface name="temperature_rear_right"/>
        <state_interface name="temperature_rear_timestamp"/>
        <state_interface name="velocity_rear_left"/>
        <state_interface name="velocity_rear_right"/>
        <state_interface name="velocity_rear_timestamp"/>
        <state_interface name="throttle_rear_left"/>
        <state_interface name="throttle_rear_right"/>
        <state_interface name="throttle_rear_timestamp"/>
        <state_interface name="reverse_rear_left"/>
        <state_interface name="reverse_rear_right"/>
        <state_interface name="reverse_rear_timestamp"/>
        <state_interface name="brake_rear_left"/>
        <state_interface name="brake_rear_right"/>
        <state_interface name="brake_rear_timestamp"/>
      </joint>
      <joint name="direction_joint">
        <state_interface name="steering_angle"/>
        <state_interface name="steering_angle_timestamp"/>
        <state_interface name="steering_torque_high"/>
        <state_interface name="steering_torque_low"/>
        <state_interface name="steering_torque_timestamp"/>
        <command_interface name="velocity"/>
        <command_interface name="direction"/>
      </joint>
    </ros2_control>

    <!-- GPS — simulation uses Gazebo plugin, not ros2_control sensor -->
    <xacro:unless value="${use_sim}">
      <ros2_control name="gps_hardware" type="sensor">
        <hardware>
          <plugin>example/GpsHardware</plugin>
          <param name="ip">192.168.1.150</param>
          <param name="port">16718</param>
          <param name="read">$(optenv GPS_READ 0)</param>
          <param name="file_name">$(optenv GPS_FILE "")</param>
        </hardware>

        <sensor name="gps_sensor">
          <state_interface name="gnss_fix"/>
          <state_interface name="latitude"/>
          <state_interface name="longitude"/>
          <state_interface name="height"/>
          <state_interface name="velocity_north"/>
          <state_interface name="velocity_east"/>
          <state_interface name="velocity_down"/>
          <state_interface name="roll"/>
          <state_interface name="pitch"/>
          <state_interface name="heading"/>
          <state_interface name="angular_velocity_x"/>
          <state_interface name="angular_velocity_y"/>
          <state_interface name="angular_velocity_z"/>
          <state_interface name="accelerometer_x"/>
          <state_interface name="accelerometer_y"/>
          <state_interface name="accelerometer_z"/>
        </sensor>
      </ros2_control>
    </xacro:unless>
  </xacro:macro>
</robot>